#: classes/woocommerce-dependencies.php:82
#: classes/woocommerce-dependencies.php:100
#, php-format
msgid ""
"Please %1$sinstall &amp; activate %3$s%2$s to allow the %4$s module to work."
msgstr ""
"لطفاً %1$s افزونه %3$s %2$sرا نصب و فعال سازی کنید تا ماژول %4$s بتواند کار "
"کند."

#: classes/woocommerce-dependencies.php:118
#, php-format
msgid ""
"Please upgrade WordPress to the latest version to allow WordPress and the "
"%1$s module to work properly."
msgstr ""
"لطفا وردپرس را به آخرین نسخه ارتقا دهید تا وردپرس و ماژول%1$s به درستی کار "
"کند."

#: classes/woocommerce-dependencies.php:133
#, php-format
msgid ""
"Please upgrade the %1$s plugin to the latest version to allow the %2$s "
"module to work."
msgstr "لطفا پلاگین %1$s را به آخرین نسخه ارتقا دهید تا ماژول %2$s کار کند."

